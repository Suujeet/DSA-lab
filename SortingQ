#include <iostream>
using namespace std;

int partition(int a[], int first, int last)
{
    int left = first;
    int right = last;
    int loc = first;
    int temp;

    while(left != right)
    {
        if(loc == left)
        {
            if(a[loc] > a[right])
            {
                temp = a[loc];
                a[loc] = a[right];
                a[right] = temp;

                loc = right;
            }
            else
            {
                right = right - 1;
            }
        }

        else if(loc == right)
        {
            if(a[loc] < a[left])
            {
                temp = a[loc];
                a[loc] = a[left];
                a[left] = temp;

                loc = left;
            }
            else
            {
                left = left + 1;
            }
        }
    }

    return loc;
}

void quickSort(int a[], int low, int high)
{
    int p;

    if(low < high)
    {
        p = partition(a, low, high);

        quickSort(a, low, p - 1);
        quickSort(a, p + 1, high);
    }
}

int main()
{
    int a[100], n, i;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter the elements: ";
    for(i = 0; i < n; i++)
        cin >> a[i];

    quickSort(a, 0, n - 1);

    cout << "Sorted array: ";
    for(i = 0; i < n; i++)
        cout << a[i] << " ";

    return 0;
}
