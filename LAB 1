#include<iostream>
using namespace std;
int main(){
	int arr[100],n,ind,value;
	cout<<"Enter number of elements:";
	cin>>n;
	cout<<"Enter array elements:";
	for(int i=0;i<n;i++){
		cin>>arr[i];
	}
	cout<<"Enter index position to insert (0 to "<<n<<"):";
	cin>>ind;
	cout<<"Enter the value to insert:";
	cin>>value;
	//Shifting elements to the right
	for(int i=n;i>ind;i--)
	{
		arr[i]=arr[i-1];
	}
	//Inserting value
	arr[ind]=value;
	n++;
	cout<<"Array after insertion:";
	for(int i=0;i<n;i++){
		cout<<arr[i]<<" ";
	}
	return 0;
	
}
